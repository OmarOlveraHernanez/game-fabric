#!/bin/sh
# Game Factory - validacion manual obligatoria antes de cada push.
# Se activa con:  git config core.hooksPath .githooks

echo ""
echo "=== Game Factory: validacion antes de push ==="

# 1) Pruebas automaticas (si ya existen)
if [ -f tools/test.ps1 ]; then
  echo "Ejecutando pruebas EditMode..."
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/test.ps1 -Quiet
  if [ $? -ne 0 ]; then
    echo "Pruebas fallidas: push bloqueado."
    exit 1
  fi
fi

# 2) Confirmacion humana (sin terminal interactiva = bloqueado)
printf "Probaste el build en emulador/telefono y revisaste docs/RELEASE_CHECKLIST.md? Escribe SI: "
if ! read answer < /dev/tty; then
  echo ""
  echo "Sin terminal interactiva: push bloqueado (solo una persona puede hacer push)."
  exit 1
fi
if [ "$answer" != "SI" ]; then
  echo "Push cancelado."
  exit 1
fi
exit 0
