* text=auto

# Codigo y texto
*.cs    text diff=csharp
*.ps1   text eol=crlf
*.md    text
*.json  text

# Serializacion YAML de Unity (Force Text)
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.asmdef  text eol=lf

# Hooks de Git deben tener LF
.githooks/* text eol=lf

# Arte y audio fuente pesado -> Git LFS
*.psd  filter=lfs diff=lfs merge=lfs -text
*.kra  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.aif  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
